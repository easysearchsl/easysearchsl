## EasySearch SL environment variables
## Copy this file to .env and fill in your values. Do NOT commit real secrets.

# Required: Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL="https://<your-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-key>"

# Optional: App display name
VITE_APP_NAME="EasySearch SL"
